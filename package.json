{
  "name": "offline-pgn-reader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.14.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "npm run typecheck",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:python": ".venv/bin/python -m pytest",
    "test:all": "npm run typecheck && npm run test:ts && npm run test:python && npm run test:browser"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@sinclair/typebox": "^0.34.40",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
