{
  "name": "offline-pgn-reader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.14.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:mobile",
    "build:mobile": "tsc -p tsconfig.mobile.json && node build-mobile.mjs",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "benchmark": "tsx benchmarks/scan.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:mobile": "playwright test --config=playwright.mobile.config.ts",
    "test:contracts": "vitest run tests-ts/contracts.test.ts",
    "test:all": "npm run typecheck && npm run test:contracts && npm run test:ts -- --exclude tests-ts/contracts.test.ts && npm run test:browser && npm run test:mobile"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@sinclair/typebox": "^0.34.40",
    "better-sqlite3": "^13.0.3",
    "chess.js": "^1.4.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true
  }
}
